<style>
  /* Footer Base Styling */
  .site-footer {
    background: var(--pink-soft);
    border-top: 3px solid var(--pink-deep);
    padding: 40px 0 28px;
    color: var(--mocha-deep);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .footer-brand .logo {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 800;
  }

  .footer-brand p {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--mocha);
    font-weight: 600;
  }

  /* Social Icons Row */
  .social-links {
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
  }

  /* Demo Tooltip Setup */
  .social-item {
    position: relative;
    display: inline-flex;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--pink-deep);
    color: var(--mocha-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform .18s var(--bounce), border-color .2s var(--ease), background .2s var(--ease);
  }

  .social-btn svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .social-item:hover .social-btn {
    transform: translateY(-3px);
    border-color: var(--mocha-deep);
    background: var(--peach);
  }

  /* Tooltip Box */
  .social-item::before {
    content: "It's a demo site!";
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: var(--mocha-deep);
    color: var(--cream);
    font-size: 11.5px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 12px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity .18s var(--bounce), transform .18s var(--bounce), visibility .18s;
    pointer-events: none;
    box-shadow: 0 4px 12px rgba(90,59,46,0.15);
    z-index: 10;
  }

  /* Tooltip Arrow */
  .social-item::after {
    content: "";
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    border-width: 6px 6px 0 6px;
    border-style: solid;
    border-color: var(--mocha-deep) transparent transparent transparent;
    opacity: 0;
    visibility: hidden;
    transition: opacity .18s var(--bounce), transform .18s var(--bounce), visibility .18s;
    pointer-events: none;
    z-index: 10;
  }

  /* Hover State for Tooltip */
  .social-item:hover::before,
  .social-item:hover::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Bottom Copyright Line */
  .footer-bottom {
    font-size: 12.5px;
    color: var(--mocha);
    border-top: 2px solid var(--pink-deep);
    padding-top: 20px;
    width: 100%;
    margin-top: 10px;
  }
</style>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <a href="/home" class="logo">StayEase</a>
      <p>Find your next cozy getaway effortlessly.</p>
    </div>

    <!-- Socials with Demo Tooltip -->
    <div class="social-links">
      <div class="social-item">
        <a href="#" class="social-btn" aria-label="Twitter">
          <svg viewBox="0 0 24 24"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
        </a>
      </div>

      <div class="social-item">
        <a href="#" class="social-btn" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="currentColor" stroke-width="2"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line></svg>
        </a>
      </div>

      <div class="social-item">
        <a href="#" class="social-btn" aria-label="Facebook">
          <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      &copy; <%= new Date().getFullYear() %> StayEase, Inc. Built for demo purposes.
    </div>
  </div>
</footer>