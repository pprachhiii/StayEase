</div>

<div class="toast" id="toast"></div>

<script id="maxPriceData" type="application/json"><%= JSON.stringify(Number(maxPrice || 0)) %></script>


<%- include('../includes/footer') %>

<script>

let state = {
  price: null,
  types: new Set(),
  rating: 0,
  bedrooms: 0,
  beds: 0,
  bathrooms: 0,
  amenities: new Set(),
  instantBook: false,
  selfCheckIn: false,
  stepFreeEntrance: false,
  wideDoorways: false,
  hostStatus: null
};
let hoveredId = null;
let sortKey = 'recommended';
const favorited = new Set();
const maxAvailablePrice = JSON.parse(document.getElementById('maxPriceData').textContent);

const resultGrid = document.getElementById('resultGrid');
const resultsCount = document.getElementById('resultsCount');
const resultsQuip = document.querySelector('.results-quip');
const noResults = document.getElementById('noResults');
const mapWrap = document.getElementById('mapWrap');
const quips = ['good taste, several options', 'these all made the cut', 'curated, not just filtered', 'worth the scroll'];

async function loadProperties() {
  const params = new URLSearchParams();

const location = "<%= typeof search !== 'undefined' && search?.location ? search.location : '' %>";

if (location.trim()) {
  params.set("location", location.trim());
}


  if (state.price !== null) {
    params.set("price", state.price);
  }

  if (state.rating > 0) {
    params.set("rating", state.rating);
  }

  if (state.types.size) {
    params.set("type", [...state.types].join(","));
  }

  if (state.bedrooms > 0) {
    params.set("bedrooms", state.bedrooms);
  }

  if (state.beds > 0) {
    params.set("beds", state.beds);
  }

  if (state.bathrooms > 0) {
    params.set("bathrooms", state.bathrooms);
  }

  if (state.amenities.size) {
    params.set("amenities", [...state.amenities].join(","));
  }

  if (state.instantBook) {
    params.set("instantBook", "true");
  }

  if (state.selfCheckIn) {
    params.set("selfCheckIn", "true");
  }

  if (state.stepFreeEntrance) {
    params.set("stepFreeEntrance", "true");
  }

  if (state.wideDoorways) {
    params.set("wideDoorways", "true");
  }

  if (state.hostStatus) {
    params.set("hostStatus", state.hostStatus);
  }

  params.set("sort", sortKey);

const response = await fetch(`/properties?${params.toString()}`, {
  headers: {
    "X-Requested-With": "XMLHttpRequest",
    Accept: "application/json"
  }
});

if (!response.ok) {
  throw new Error(`Failed to load properties: ${response.status}`);
}

const data = await response.json();

render(data.properties || []);

}

  

function cardHTML(p) {
  const images = Array.isArray(p.images) ? p.images : [];

  const imgs = images
    .map(
      (src) => `
        <img
          src="${src}"
          alt="${p.title || "Property"}"
          loading="lazy"
        >
      `
    )
    .join("");

  const dots = images
    .map(
      (_, i) =>
        `<span class="${i === 0 ? "active" : ""}"></span>`
    )
    .join("");

  const location = [
    p.location?.city,
    p.location?.country,
  ]
    .filter(Boolean)
    .join(", ");

  return `
    <div class="card" data-id="${p.id}">
      <div
        class="card-photo"
        data-idx="0"
        data-count="${images.length}"
      >

        <div class="track">
          ${imgs}
        </div>

        ${
          p.vibe
            ? `<span class="vibe-tag">${p.vibe}</span>`
            : ""
        }

        ${
          images.length > 1
            ? `
              <button
                class="card-arrow left"
                aria-label="Previous photo"
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#5A3B2E"
                  stroke-width="2"
                >
                  <path d="M15 6l-6 6 6 6"/>
                </svg>
              </button>

              <button
                class="card-arrow right"
                aria-label="Next photo"
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#5A3B2E"
                  stroke-width="2"
                >
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </button>

              <div class="card-dots">
                ${dots}
              </div>
            `
            : ""
        }

        <button
          class="fav-btn ${p.isFavorited ? "active" : ""}"
          aria-label="Save to wishlist"
        >
          <svg viewBox="0 0 24 24">
            <path d="M12 21s-7.5-4.6-10-9.1C.5 8.2 2.3 4.8 5.6 4.1c2-.4 4 .5 6.4 3 2.4-2.5 4.4-3.4 6.4-3 3.3.7 5.1 4.1 3.6 7.8-2.5 4.5-10 9.1-10 9.1z"/>
          </svg>
        </button>
      </div>

      <div class="card-top">
        <span class="card-title">
          ${p.title || ""}
        </span>

        <span class="card-rating">
          <svg viewBox="0 0 24 24">
            <path d="M12 2l2.9 6.6L21 9.3l-5 4.6 1.3 6.8L12 17.3 6.7 20.7 8 13.9 3 9.3l6.1-.7z"/>
          </svg>
          ${Number(p.rating || 0).toFixed(2)}
        </span>
      </div>

      <p class="card-loc">
        ${location}
      </p>

      <p class="card-price">
        <b>${p.currency || "€"}${Number(p.price || 0).toLocaleString()}</b>
        / night
      </p>
    </div>
  `;
}

function pinHTML(p) {
  return `
    <div
      class="pin"
      data-id="${p.id}"
      style="top:${p.top};left:${p.left};"
    >
      ${p.currency || "€"}${Number(p.price || 0).toLocaleString()}
    </div>
  `;
}

function render(properties) {
  const list = Array.isArray(properties) ? properties : [];

  resultsCount.textContent = list.length ? `${list.length} stays` : "";
  if (resultsQuip) {
    resultsQuip.textContent = list.length
      ? quips[Math.floor(Math.random() * quips.length)]
      : "";
  }

  resultGrid.style.display = list.length ? "grid" : "none";
  noResults.style.display = list.length ? "none" : "block";
  resultGrid.innerHTML = list.map(cardHTML).join("");

  mapWrap.querySelectorAll(".pin").forEach((pin) => pin.remove());
  list.forEach((property) => {
    mapWrap.insertAdjacentHTML("beforeend", pinHTML(property));
  });
  attachPinEvents();
}

function attachPinEvents(){
  mapWrap.querySelectorAll('.pin').forEach(pin=>{
    pin.addEventListener('mouseenter', ()=>setHover(pin.dataset.id));
    pin.addEventListener('mouseleave', ()=>setHover(null));
  });
}
function setHover(id){
  hoveredId = id;
  document.querySelectorAll('.pin').forEach(p=>p.classList.toggle('hovered', p.dataset.id===id));
  document.querySelectorAll('.card').forEach(c=>c.classList.toggle('hovered', c.dataset.id===id));
}
resultGrid.addEventListener('mouseover', (e)=>{ const card = e.target.closest('.card'); if(card) setHover(card.dataset.id); });
resultGrid.addEventListener('mouseleave', ()=> setHover(null));

const toast = document.getElementById('toast');
const toastMsgs = ['saved - hoard growing 🏴', 'added to the list', 'noted, excellent taste', 'saved for later scheming'];
function showToast(msg){
  toast.textContent = msg;
  toast.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(()=> toast.classList.remove('show'), 1600);
}
function spawnSparkles(container){
  const palette = ['var(--peach)','var(--pink-deep)','var(--mocha)'];
  for(let i=0;i<6;i++){
    const s = document.createElement('span');
    s.className = 'spark';
    const angle = (Math.PI*2*i)/6;
    const dist = 20 + Math.random()*10;
    s.style.left='16px'; s.style.top='16px';
    s.style.background = palette[i % palette.length];
    container.appendChild(s);
    s.animate([{transform:'translate(0,0) scale(1)', opacity:1},{transform:`translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px) scale(0)`, opacity:0}], {duration:480, easing:'cubic-bezier(.22,.61,.36,1)'});
    setTimeout(()=> s.remove(), 500);
  }
}
resultGrid.addEventListener('click', (e)=>{
  const fav = e.target.closest('.fav-btn');
  const arrow = e.target.closest('.card-arrow');
  const card = e.target.closest('.card');
  if(fav){
    e.stopPropagation();
    const id = card.dataset.id;
    const nowActive = !fav.classList.contains('active');
    fav.classList.toggle('active');
    fav.classList.remove('pulse'); void fav.offsetWidth; fav.classList.add('pulse');
    fetch(`/wishlist/${id}`, { method: nowActive ? 'POST' : 'DELETE', headers: { Accept: 'application/json' } })
      .then(response => { if (!response.ok) throw new Error('login required'); return response.json(); })
      .then(() => { if(nowActive){ spawnSparkles(fav); showToast(toastMsgs[Math.floor(Math.random()*toastMsgs.length)]); } })
      .catch(() => { fav.classList.toggle('active'); showToast('Log in to save stays'); });
    return;
  }
  if(arrow){
    e.stopPropagation();
    const photo = e.target.closest('.card-photo');
    const track = photo.querySelector('.track');
    const count = Number(photo.dataset.count);
    let idx = Number(photo.dataset.idx);
    idx = arrow.classList.contains('right') ? (idx+1)%count : (idx-1+count)%count;
    photo.dataset.idx = idx;
    track.style.transform = `translateX(-${idx*100}%)`;
    photo.querySelectorAll('.card-dots span').forEach((d,i)=>d.classList.toggle('active', i===idx));
  }
  if (card) window.location.href = `/properties/${card.dataset.id}`;
});

function closeAllPopovers(except){ document.querySelectorAll('.popover').forEach(p=>{ if(p.id!==except) p.classList.remove('open'); }); }
document.querySelectorAll('.chip[data-pop]').forEach(chip=>{
  chip.addEventListener('click', (e)=>{
    e.stopPropagation();
    const pop = document.getElementById(chip.dataset.pop);
    const isOpen = pop.classList.contains('open');
    closeAllPopovers();
    if (!isOpen) {
      const rect = chip.getBoundingClientRect();
      pop.style.left = `${Math.max(12, Math.min(rect.left, window.innerWidth - pop.offsetWidth - 12))}px`;
      pop.style.top = `${rect.bottom + 10}px`;
      pop.classList.add('open');
    }
  });
});
document.addEventListener('click', ()=> closeAllPopovers());
document.querySelectorAll('.popover').forEach(p=>p.addEventListener('click', e=>e.stopPropagation()));

const priceSlider = document.getElementById('priceSlider');
const priceLabel = document.getElementById('priceLabel');
priceSlider.addEventListener('input', ()=>{ priceLabel.textContent = priceSlider.value >= maxAvailablePrice ? `up to $${maxAvailablePrice}+ / night` : `up to $${priceSlider.value} / night`; });
document.getElementById('priceApply').addEventListener('click', ()=>{
  state.price = Number(priceSlider.value);
  document.getElementById('priceChip').classList.toggle('active', state.price < maxAvailablePrice);
  closeAllPopovers(); loadProperties();
;
});
document.getElementById('priceClear').addEventListener('click', ()=>{
  priceSlider.value = maxAvailablePrice; priceLabel.textContent = `up to $${maxAvailablePrice} / night`; state.price = null;
  document.getElementById('priceChip').classList.remove('active'); loadProperties();
});

const typePop = document.getElementById('typePop');
document.getElementById('typeApply').addEventListener('click', ()=>{
  state.types = new Set([...typePop.querySelectorAll('input:checked')].map(i=>i.value));
  document.getElementById('typeChip').classList.toggle('active', state.types.size>0);
  closeAllPopovers(); loadProperties();
});
document.getElementById('typeClear').addEventListener('click', ()=>{
  typePop.querySelectorAll('input').forEach(i=>i.checked=false);
  state.types = new Set();
  document.getElementById('typeChip').classList.remove('active'); loadProperties();
});
document.getElementById('ratingChips').addEventListener('click', (e)=>{
  const btn = e.target.closest('.radio-chip'); if(!btn) return;
  document.querySelectorAll('#ratingChips .radio-chip').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  state.rating = Number(btn.dataset.val);
  document.getElementById('ratingChip').classList.toggle('active', state.rating>0);
  loadProperties();
});

const sortBtn = document.getElementById('sortBtn');
const sortMenu = document.getElementById('sortMenu');
sortBtn.addEventListener('click', (e)=>{ e.stopPropagation(); sortMenu.classList.toggle('open'); });
document.addEventListener('click', ()=> sortMenu.classList.remove('open'));
sortMenu.addEventListener('click', (e)=>{
  const opt = e.target.closest('.sort-option'); if(!opt) return;
  sortKey = opt.dataset.sort;
  document.getElementById('sortLabel').textContent = opt.textContent;
  document.querySelectorAll('.sort-option').forEach(o=>o.classList.remove('selected'));
  opt.classList.add('selected'); loadProperties();
});

function clearAll() {
  state = {
    price: null,
    types: new Set(),
    rating: 0,
    bedrooms: 0,
    beds: 0,
    bathrooms: 0,
    amenities: new Set(),
    instantBook: false,
    selfCheckIn: false,
    stepFreeEntrance: false,
    wideDoorways: false,
    hostStatus: null
  };

  priceSlider.value = priceSlider.max;
  priceLabel.textContent = `up to $${priceSlider.max} / night`;

  typePop
    .querySelectorAll("input")
    .forEach(input => input.checked = false);

  document
    .querySelectorAll("#ratingChips .radio-chip")
    .forEach((button, index) => {
      button.classList.toggle("selected", index === 0);
    });

  document
    .querySelectorAll(".chip.active")
    .forEach(chip => chip.classList.remove("active"));

  loadProperties();
}
document.getElementById('suggestClear').addEventListener('click', clearAll);
document.getElementById('suggestNearby').addEventListener('click', clearAll);
document.getElementById('suggestDates').addEventListener('click', clearAll);

const drawer = document.getElementById('drawer');
const drawerOverlay = document.getElementById('drawerOverlay');
function openDrawer(sectionId){
  drawer.classList.add('open');
  drawerOverlay.classList.add('open');
  if (sectionId) {
    requestAnimationFrame(() => {
      document.getElementById(sectionId)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
}
function closeDrawer(){ drawer.classList.remove('open'); drawerOverlay.classList.remove('open'); }
document.getElementById('allFiltersBtn').addEventListener('click', openDrawer);
document.getElementById('bedroomsChip').addEventListener('click', () => openDrawer('roomsFilterSection'));
document.getElementById('amenitiesChip').addEventListener('click', () => openDrawer('amenitiesFilterSection'));
document.getElementById('accessibilityChip').addEventListener('click', () => openDrawer('accessibilityFilterSection'));
document.getElementById('drawerClose').addEventListener('click', closeDrawer);
drawerOverlay.addEventListener('click', closeDrawer);

const drawerSlider = document.getElementById('drawerPriceSlider');
const drawerPriceLabel = document.getElementById('drawerPriceLabel');
drawerSlider.addEventListener('input', ()=>{ drawerPriceLabel.textContent = drawerSlider.value >= maxAvailablePrice ? `up to $${maxAvailablePrice}+ / night` : `up to $${drawerSlider.value} / night`; });
document.querySelectorAll('.stepper button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const targetId = {bed:'bedVal', beds:'bedsVal', bath:'bathVal'}[btn.dataset.t];
    const span = document.getElementById(targetId);
    let val = span.textContent === 'Any' ? 0 : Number(span.textContent);
    val = Math.max(0, val + Number(btn.dataset.d));
    span.textContent = val === 0 ? 'Any' : val;
  });
});
document.querySelectorAll('[data-switch]').forEach(sw=>{ sw.addEventListener('click', ()=> sw.classList.toggle('on')); });
document.getElementById('drawerApply').addEventListener('click', ()=>{
  state.price = Number(drawerSlider.value);
  priceSlider.value = drawerSlider.value;
  priceLabel.textContent = drawerPriceLabel.textContent;
  document.getElementById('priceChip').classList.toggle('active', state.price < maxAvailablePrice);
  const checked = [...document.getElementById('drawerTypeGrid').querySelectorAll('input:checked')].map(i=>i.value);
  state.types = new Set(checked);
  state.amenities = new Set([...document.getElementById('drawerAmenityGrid').querySelectorAll('input:checked')].map(i=>i.value));
  state.bedrooms = Number(document.getElementById('bedVal').textContent === 'Any' ? 0 : document.getElementById('bedVal').textContent);
  state.beds = Number(document.getElementById('bedsVal').textContent === 'Any' ? 0 : document.getElementById('bedsVal').textContent);
  state.bathrooms = Number(document.getElementById('bathVal').textContent === 'Any' ? 0 : document.getElementById('bathVal').textContent);
  const switches = [...document.querySelectorAll('[data-switch]')].map(sw => sw.classList.contains('on'));
  [state.instantBook, state.selfCheckIn, state.stepFreeEntrance, state.wideDoorways] = switches;
  const selectedHost = document.querySelector('[data-host].selected');
  state.hostStatus = selectedHost?.dataset.host || null;
  typePop.querySelectorAll('input').forEach(i=>{ i.checked = checked.includes(i.value); });
  document.getElementById('typeChip').classList.toggle('active', state.types.size>0);
  closeDrawer(); loadProperties();
});
document.getElementById('drawerClear').addEventListener('click', ()=>{
  drawerSlider.value = maxAvailablePrice; drawerPriceLabel.textContent = `up to $${maxAvailablePrice} / night`;
  document.getElementById('drawerTypeGrid').querySelectorAll('input').forEach(i=>i.checked=false);
  document.getElementById('drawerAmenityGrid').querySelectorAll('input').forEach(i=>i.checked=false);
  document.querySelectorAll('.stepper span').forEach(s=>s.textContent='Any');
  document.querySelectorAll('[data-switch]').forEach(sw=>sw.classList.remove('on'));
  document.querySelectorAll('[data-host]').forEach((button, index)=>button.classList.toggle('selected', index === 0));
  clearAll();
});
document.querySelectorAll('[data-host]').forEach(button => button.addEventListener('click', () => {
  document.querySelectorAll('[data-host]').forEach(item => item.classList.remove('selected'));
  button.classList.add('selected');
}));

const mapCol = document.getElementById('mapCol');
const mapToggleBtn = document.getElementById('mapToggleBtn');
const mapClose = document.getElementById('mapClose');
mapToggleBtn.addEventListener('click', ()=>{ mapCol.classList.add('show'); mapClose.classList.add('show'); });
mapClose.addEventListener('click', ()=>{ mapCol.classList.remove('show'); mapClose.classList.remove('show'); });

loadProperties();



</script>