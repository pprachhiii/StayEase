<script id="globePropertiesData" type="application/json"><%- JSON.stringify((globeProperties || []).map(property => ({ id: property._id.toString(), name: property.title, city: property.location?.city || "", country: property.location?.country || "", price: property.price, rating: property.rating || 0, image: property.images?.[0] || "", lat: property.geometry.coordinates[1], lon: property.geometry.coordinates[0] }))).replace(/</g, "\\u003c") %></script>

<script>
const words = ['Stays','Experiences','Destinations','Quiet Escapes','Design-led Stays','Weekend Hideaways','Coastal Stays','Mountain Retreats','City Residences','Long Stays'];
const track = document.getElementById('marqueeTrack');
const loopContent = words.map(w=>`<span>${w}</span>`).join('') ;
track.innerHTML = loopContent + loopContent;

/* ---------- GLOBE ---------- */
(function(){
  const canvas = document.getElementById('globeCanvas');
  const ctx = canvas.getContext('2d');
  const tooltip = document.getElementById('globeTooltip');
  const hotelCard = document.getElementById('globeHotelCard');
  const DPR = Math.min(window.devicePixelRatio || 1, 2);
  const SIZE = 600;
  canvas.width = SIZE * DPR; canvas.height = SIZE * DPR;
  ctx.scale(DPR, DPR);
  const R = SIZE/2 - 20;
  const CX = SIZE/2, CY = SIZE/2;

  const landBoxes = [
    {latMin:15, latMax:72, lonMin:-168, lonMax:-52},
    {latMin:-56, latMax:13, lonMin:-82, lonMax:-34},
    {latMin:36, latMax:71, lonMin:-10, lonMax:40},
    {latMin:-35, latMax:37, lonMin:-18, lonMax:52},
    {latMin:5, latMax:77, lonMin:40, lonMax:180},
    {latMin:-44, latMax:-10, lonMin:112, lonMax:154},
  ];
  function isLand(lat, lon){ return landBoxes.some(b => lat>=b.latMin && lat<=b.latMax && lon>=b.lonMin && lon<=b.lonMax); }

  const points = [];
  const N = 1400;
  for(let i=0;i<N;i++){
    const y = 1 - (i/(N-1))*2;
    const radiusAtY = Math.sqrt(1 - y*y);
    const theta = Math.PI*(1+Math.sqrt(5))*i;
    const x = Math.cos(theta)*radiusAtY;
    const z = Math.sin(theta)*radiusAtY;
    const lat = Math.asin(y)*180/Math.PI;
    const lon = Math.atan2(z, x)*180/Math.PI;
    if(isLand(lat, lon)) points.push({lat, lon});
  }

  const markers = JSON.parse(document.getElementById('globePropertiesData').textContent);

  let rotY = 0.4, rotX = -0.25, autoRotate = true, dragging = false, lastX = 0, lastY = 0;

  function project(lat, lon){
    const phi = lat*Math.PI/180;
    const theta = lon*Math.PI/180 + rotY;
    let x = Math.cos(phi)*Math.cos(theta);
    let y = Math.sin(phi);
    let z = Math.cos(phi)*Math.sin(theta);
    const cosT = Math.cos(rotX), sinT = Math.sin(rotX);
    const y2 = y*cosT - z*sinT;
    const z2 = y*sinT + z*cosT;
    return {x: x*R + CX, y: y2*R + CY, z: z2, visible: z2 > -R*0.02};
  }

  let hovered = null;
  const pulseStart = performance.now();

  function draw(){
    ctx.clearRect(0,0,SIZE,SIZE);
    ctx.beginPath();
    ctx.arc(CX, CY, R, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(252,243,232,0.16)';
    ctx.lineWidth = 1.5; ctx.stroke();

    points.forEach(p => {
      const proj = project(p.lat, p.lon);
      if(!proj.visible) return;
      const depth = (proj.z + R) / (2*R);
      const alpha = 0.2 + depth*0.55;
      const size = 1.2 + depth*1.2;
      ctx.beginPath();
      ctx.arc(proj.x, proj.y, size, 0, Math.PI*2);
      ctx.fillStyle = `rgba(252,243,232,${alpha})`;
      ctx.fill();
    });

    const pulse = 0.5 + 0.5*Math.sin((performance.now()-pulseStart)/450);
    markers.forEach(m => {
      const proj = project(m.lat, m.lon);
      if(!proj.visible) return;
      const isHover = hovered === m;
      const r = isHover ? 7 : 4.5 + pulse*1.3;
      ctx.beginPath();
      ctx.arc(proj.x, proj.y, r, 0, Math.PI*2);
      ctx.fillStyle = isHover ? '#FCF3E8' : '#EFAF8B';
      ctx.fill();
      if(isHover){
        ctx.beginPath();
        ctx.arc(proj.x, proj.y, 12, 0, Math.PI*2);
        ctx.strokeStyle = 'rgba(252,243,232,0.5)';
        ctx.lineWidth = 1.5; ctx.stroke();
      }
      m._proj = proj;
    });
    requestAnimationFrame(step);
  }

  let lastTime = performance.now();
  function step(now){
    const dt = Math.min(now - lastTime, 48);
    lastTime = now;
    if(autoRotate && !dragging) rotY += 0.00016 * dt;
    draw();
  }
  requestAnimationFrame(step);

  function getPos(e){
    const rect = canvas.getBoundingClientRect();
    const scaleX = SIZE/rect.width, scaleY = SIZE/rect.height;
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return {x:(clientX-rect.left)*scaleX, y:(clientY-rect.top)*scaleY, clientX, clientY, rect};
  }
  function onDown(e){ dragging = true; autoRotate = false; const p = getPos(e); lastX = p.x; lastY = p.y; }
  let movedWhileDragging = false;
  function onMove(e){
    const p = getPos(e);
    if(dragging){
      const dx = p.x - lastX, dy = p.y - lastY;
      if(Math.abs(dx) > 2 || Math.abs(dy) > 2) movedWhileDragging = true;
      rotY += dx * 0.006;
      rotX = Math.max(-1.1, Math.min(1.1, rotX + dy * 0.006));
      lastX = p.x; lastY = p.y;
      e.preventDefault();
    }
    let found = null;
    for(const m of markers){
      if(!m._proj || !m._proj.visible) continue;
      const dx = p.x - m._proj.x, dy = p.y - m._proj.y;
      if(dx*dx+dy*dy < 15*15){ found = m; break; }
    }
    hovered = found;
    if(found){
      tooltip.textContent = found.city || found.country || found.name;
      tooltip.classList.add('show');
      hotelCard.innerHTML = `${found.image ? `<img src="${escapeHtml(found.image)}" alt="${escapeHtml(found.name)}">` : ''}<strong>${escapeHtml(found.name)}</strong>`;
      hotelCard.classList.add('show');
      const wrapRect = canvas.parentElement.getBoundingClientRect();
      tooltip.style.left = (p.clientX - wrapRect.left) + 'px';
      tooltip.style.top = (p.clientY - wrapRect.top) + 'px';
      hotelCard.style.left = (p.clientX - wrapRect.left) + 'px';
      hotelCard.style.top = (p.clientY - wrapRect.top) + 'px';
      canvas.style.cursor = 'pointer';
    } else {
      tooltip.classList.remove('show');
      hotelCard.classList.remove('show');
      canvas.style.cursor = dragging ? 'grabbing' : 'grab';
    }
  }
  function onUp(){ dragging = false; }
  function escapeHtml(value){
    return String(value).replace(/[&<>'"]/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[character]));
  }
  canvas.addEventListener('click', (event) => {
    if (movedWhileDragging) {
      movedWhileDragging = false;
      return;
    }
    const position = getPos(event);
    const clicked = markers.find(marker => {
      const projection = project(marker.lat, marker.lon);
      if (!projection.visible) return false;
      const dx = position.x - projection.x;
      const dy = position.y - projection.y;
      return dx * dx + dy * dy < 22 * 22;
    });
    if (clicked) window.location.href = `/properties/${clicked.id}`;
    movedWhileDragging = false;
  });
  canvas.addEventListener('mousedown', onDown);
  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', onUp);
  canvas.addEventListener('touchstart', onDown, {passive:true});
  canvas.addEventListener('touchmove', onMove, {passive:false});
  canvas.addEventListener('touchend', onUp);
})();
</script>
</body>
</html>