<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Log in</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FCF3E8; --pink:#F5C6D6; --pink-soft:#F9DCE6; --pink-deep:#EDA9C4;
    --mocha:#7B5240; --mocha-deep:#5A3B2E; --peach:#EFAF8B; --mint:#B7D8B0; --white:#FFFFFF;
    --display:"Baloo 2", "Quicksand", sans-serif; --sans:"Quicksand", -apple-system, sans-serif;
    --ease: cubic-bezier(.22,.61,.36,1); --bounce: cubic-bezier(.34,1.56,.64,1);
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--cream);color:var(--mocha-deep);font-family:var(--sans);font-weight:600;line-height:1.5;min-height:100vh;overflow-x:hidden;}
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;}
  input{font-family:inherit;}
  a:focus-visible, button:focus-visible, input:focus-visible{outline:2px solid var(--mocha-deep);outline-offset:2px;border-radius:6px;}
  @media (prefers-reduced-motion: reduce){ *{animation-duration:.001ms !important;transition-duration:.001ms !important;} }

  .top-bar{display:flex;justify-content:space-between;align-items:center;padding:28px 40px;position:relative;z-index:3;background:var(--pink);}
  .logo{font-family:var(--display);font-size:24px;font-weight:800;}

  .stage{position:relative;min-height:calc(100vh - 94px);display:flex;align-items:center;justify-content:center;padding:20px 20px 60px;background:var(--pink);}
  .blob{position:absolute;border-radius:50%;opacity:0.7;z-index:1;}
  .blob.b1{width:280px;height:260px;background:var(--pink-soft);top:8%;left:8%;border-radius:48% 52% 55% 45%/45% 48% 52% 55%;}
  .blob.b2{width:220px;height:240px;background:var(--peach);bottom:10%;left:14%;border-radius:55% 45% 48% 52%/52% 55% 45% 48%;opacity:0.6;}
  .blob.b3{width:200px;height:190px;background:var(--mint);top:12%;right:10%;border-radius:45% 55% 52% 48%/55% 45% 48% 52%;opacity:0.55;}
  .blob.b4{width:180px;height:200px;background:var(--pink-deep);bottom:6%;right:12%;border-radius:52% 48% 45% 55%/48% 52% 55% 45%;opacity:0.5;}
  @media (max-width:760px){.blob{display:none;}}

  .auth-card{position:relative;z-index:2;width:420px;max-width:92vw;background:var(--white);border:3px solid var(--pink-deep);border-radius:28px;padding:40px 36px 32px;box-shadow:0 20px 50px rgba(90,59,46,0.14);}
  .auth-eyebrow{font-family:var(--display);color:var(--pink-deep);font-size:16px;font-weight:700;margin:0 0 4px;}
  h1.auth-title{font-family:var(--display);font-size:30px;font-weight:800;margin:0 0 24px;}

  .field{margin-bottom:16px;}
  .field label{display:block;font-size:12.5px;font-weight:800;margin-bottom:6px;}
  .field-input-wrap{position:relative;}
  .field input{width:100%;padding:12px 14px;border:2px solid var(--pink-deep);border-radius:14px;font-size:14.5px;font-weight:600;background:var(--cream);transition:border-color .2s var(--ease), box-shadow .2s var(--ease);}
  .field input:focus{border-color:var(--mocha-deep);box-shadow:0 0 0 3px rgba(90,59,46,0.1);outline:none;}
  .field input.error{border-color:#D9694F;}
  .field-error{font-size:12.5px;color:#B4523B;font-weight:700;margin-top:6px;display:none;}
  .field.has-error .field-error{display:block;}
  .toggle-visibility{position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;padding:0;color:var(--mocha);display:flex;align-items:center;justify-content:center;}
  .toggle-visibility:hover{color:var(--mocha-deep);}

  .btn-primary{width:100%;padding:13px;border-radius:16px;background:var(--mocha-deep);color:var(--cream);font-family:var(--display);font-size:16px;font-weight:800;border:none;margin-top:8px;transition:background .2s var(--ease), transform .15s var(--bounce);}
  .btn-primary:hover{background:var(--mocha);}
  .btn-primary:active{transform:scale(0.98);}
  .btn-primary.shake{animation:shake .4s;}
  @keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-6px);}75%{transform:translateX(6px);}}

  .switch-line{text-align:center;font-size:14px;font-weight:600;color:var(--mocha);margin-top:24px;}
  .switch-line a{font-weight:800;color:var(--mocha-deep);text-decoration:underline;}
</style>
</head>

<body>

<div class="top-bar">
  <a class="logo" href="/">StayEase</a>
</div>

<div class="stage">
  <div class="blob b1"></div>
  <div class="blob b2"></div>
  <div class="blob b3"></div>
  <div class="blob b4"></div>

  <div class="auth-card">
    <p class="auth-eyebrow">oh hey, you're back</p>
    <h1 class="auth-title">Log in to StayEase</h1>

    <form id="loginForm" action="/login" method="POST" class="needs-validation" novalidate>
      <div class="field" id="emailField">
        <label for="email">Email address</label>
        <input name="email" id="email" type="email" class="form-control" placeholder="name@example.com" required>
        <p class="field-error">Please enter a valid email address.</p>
      </div>

      <div class="field" id="passwordField">
        <label for="password">Password</label>
        <div class="field-input-wrap">
          <input id="password" name="password" type="password" class="form-control" placeholder="••••••••" required>
          <button type="button" class="toggle-visibility" id="togglePw" aria-label="Show password">
            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          </button>
        </div>
        <p class="field-error">Passwords need at least one character.</p>
      </div>

      <button id="loginSubmit" type="submit" class="btn btn-primary">Log in</button>
    </form>
    
    <p class="switch-line">New here? <a href="/register">Create an account</a></p>
  </div>
</div>

<script>
// SVG Paths for Eye icons
const eyeOpenPath = `<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/>`;
const eyeClosedPath = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>`;

// Password toggle button
document.getElementById('togglePw').addEventListener('click', function() {
  const pwInput = document.getElementById('password');
  const eyeIcon = document.getElementById('eyeIcon');
  const isPassword = pwInput.type === 'password';
  
  // Toggle input type
  pwInput.type = isPassword ? 'text' : 'password';
  
  // Switch SVG icon depending on state
  eyeIcon.innerHTML = isPassword ? eyeOpenPath : eyeClosedPath;
  this.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
  this.style.color = isPassword ? 'var(--mocha-deep)' : 'var(--mocha)';
});

// Form submission & validation
document.getElementById('loginForm').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const emailInput = document.getElementById('email');
  const emailField = document.getElementById('emailField');
  const pwInput = document.getElementById('password');
  const pwField = document.getElementById('passwordField');

  let valid = true;

  // Validate Email
  const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim());
  emailField.classList.toggle('has-error', !emailOk);
  emailInput.classList.toggle('error', !emailOk);
  if (!emailOk) valid = false;

  // Validate Password Length
  const pwOk = pwInput.value.length > 0;
  pwField.classList.toggle('has-error', !pwOk);
  pwInput.classList.toggle('error', !pwOk);
  if (!pwOk) valid = false;

  const submitBtn = document.getElementById('loginSubmit');
  if (!valid) {
    submitBtn.classList.remove('shake'); 
    void submitBtn.offsetWidth;
    submitBtn.classList.add('shake');
    return;
  }

  submitBtn.textContent = 'Logging in…';
  this.submit();
});
</script>

</body>
</html>